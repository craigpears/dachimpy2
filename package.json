{
  "name": "carpentry-primer",
  "private": true,
  "scripts": {
    "build": "tsc -p . && node tools/bundle.mjs && node tools/lines-doc.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tests",
    "task": "node tools/task.mjs",
    "board": "node tools/task.mjs board",
    "board:serve": "node tools/task.mjs serve",
    "smoke": "node tools/smoke.mjs",
    "hooks": "git config core.hooksPath tools/hooks"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.49.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
